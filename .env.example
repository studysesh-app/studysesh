# Copy this file to .env — the app won't start without it.
#   cp .env.example .env
#
# DEMO_MODE=true runs the app fully offline (any login works, mock data, no Supabase
# needed). Perfect for front-end work. Set to false only when working against the
# real Supabase project (ask Kshitij for the URL + anon key).
EXPO_PUBLIC_DEMO_MODE=true

# Only needed when EXPO_PUBLIC_DEMO_MODE=false:
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
